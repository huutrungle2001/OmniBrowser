        "ordinal": "first"
      },
      "value": "{{files}}"
    }
  ],
  "validation": {},
  "metadata": {
    "version": "1.0",
    "success_count": 0,
    "failure_count": 0,
    "last_failure_reason": null,
    "failure_ledger": []
  }
}
